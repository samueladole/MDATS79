# ═══════════════════════════════════════════════════════════════════════════════
# RAGScope — research configuration (the dissertation's 2×2 experiment)
#
#   cp .env.research.example .env
#
# Exactly the setup behind the published results: Llama 3 8B and Mistral 7B as
# generators, Qwen2.5 7B as the RAGAS judge, ChromaDB as a server. Expect about
# 55 s per evaluated query on an Apple M-series GPU, and much longer on CPU
# only (the 3B CPU defaults already take about 2 minutes). For a CPU laptop, use
# .env.example.
# ═══════════════════════════════════════════════════════════════════════════════

# ── LLM (Ollama) ──────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
GENERATOR_MODELS=llama3,mistral
DEFAULT_LLM=llama3

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_STRATEGY=hybrid             # dense | hybrid | graph
TOP_K=5

# ── Graph retrieval ───────────────────────────────────────────────────────────
GRAPH_PATH=data/graph/graph.json
GRAPH_NODE_CHUNKS_PATH=data/graph/node_to_chunks.json
GRAPH_FUSE_DENSE=true

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_MODE=http                      # the published runs used the chromadb server
CHROMA_HOST=localhost                 # Docker sets this to the chromadb service
CHROMA_PORT=8000
CHROMA_COLLECTION=ragscope_corpus

# ── RAGAS ─────────────────────────────────────────────────────────────────────
RAGAS_JUDGE_MODEL=qwen2.5:7b

# ── Cost estimation ───────────────────────────────────────────────────────────
COST_PER_1K_PROMPT_TOKENS=0.00
COST_PER_1K_COMPLETION_TOKENS=0.00

# ── Telemetry ─────────────────────────────────────────────────────────────────
TELEMETRY_STORE_DIR=./telemetry/store

# ── Logging and dashboard ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
STREAMLIT_LOGGER_LEVEL=info
PYTHONDONTWRITEBYTECODE=1
