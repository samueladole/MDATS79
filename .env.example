# ═══════════════════════════════════════════════════════════════════════════════
# RAGScope — default configuration (CPU-only laptop)
#
#   cp .env.example .env
#
# Small models and an embedded vector store, so RAGScope runs on a laptop with
# no GPU and no database server. To reproduce the dissertation results exactly
# (Llama 3 8B / Mistral 7B generators, Qwen2.5 7B judge), use
# .env.research.example instead.
# ═══════════════════════════════════════════════════════════════════════════════

# ── LLM (Ollama) ──────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
GENERATOR_MODELS=llama3.2:3b,qwen2.5:3b     # Offered in the dashboard; pull each with `ollama pull`
DEFAULT_LLM=llama3.2:3b                     # Must be one of GENERATOR_MODELS

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_STRATEGY=hybrid             # dense | hybrid | graph
TOP_K=5                               # Number of retrieved passages per query

# ── Graph retrieval ───────────────────────────────────────────────────────────
GRAPH_PATH=data/graph/graph.json       # Built by graph/build_graph.py
GRAPH_NODE_CHUNKS_PATH=data/graph/node_to_chunks.json
GRAPH_FUSE_DENSE=true                  # false -> graph-only results
# Why false is sometimes wanted: while the graph covers less of the corpus than
# the dense index, RRF cannot promote a graph-only chunk into a small top-k —
# graph rank 1 scores 0.4/61 = 0.00656 against dense rank 5 at 0.6/65 = 0.00923.
# Fused mode therefore lets the graph re-rank what dense found but never
# introduce anything, hiding the traversal mechanism.

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu                  # cpu | cuda | mps

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_MODE=embedded                  # embedded: no server, index under CHROMA_PATH
CHROMA_PATH=data/chroma_store         #   (Docker always uses http to the chromadb service)
CHROMA_HOST=localhost                 # http mode only
CHROMA_PORT=8000                      # http mode only
CHROMA_COLLECTION=ragscope_corpus

# ── RAGAS ─────────────────────────────────────────────────────────────────────
RAGAS_JUDGE_MODEL=qwen2.5:3b          # LLM that scores each answer (3 calls per query)
RAGAS_TIMEOUT_SECONDS=600             # per judge call; the CPU queues all 3 calls
OLLAMA_TIMEOUT_SECONDS=300            # per answer generation

# ── Cost estimation ───────────────────────────────────────────────────────────
COST_PER_1K_PROMPT_TOKENS=0.00        # 0.00 for local inference; set for cloud models
COST_PER_1K_COMPLETION_TOKENS=0.00

# ── Telemetry ─────────────────────────────────────────────────────────────────
TELEMETRY_STORE_DIR=./telemetry/store

# ── Logging and dashboard ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
STREAMLIT_LOGGER_LEVEL=info
PYTHONDONTWRITEBYTECODE=1
