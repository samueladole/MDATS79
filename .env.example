# ── Dashboard ──────────────────────────────────────────────────────────────
STREAMLIT_SERVER_RUN_ON_SAVE=true           # Automatically rerun Streamlit app on file changes
STREAMLIT_SERVER_FILE_WATCHER_TYPE=auto     # File watcher type: auto | polling | none
STREAMLIT_LOGGER_LEVEL=debug                # Log level for Streamlit: debug | info | warning | error | critical

# Prevent Python from writing .pyc files to disk
PYTHONDONTWRITEBYTECODE=1

# ── LLM ────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434   # Local: http://localhost:11434
DEFAULT_LLM=llama3                                  # llama3 | mistral

# ── Retrieval ───────────────────────────────────────────────────────────────
RETRIEVAL_STRATEGY=hybrid             # dense | hybrid | graph
TOP_K=5                               # Number of retrieved passages per query

# ── Graph retrieval ───────────────────────────────────────────────────────────
GRAPH_PATH=data/graph/graph.json       # Built by graph/spikes/build_subset.py
GRAPH_NODE_CHUNKS_PATH=data/graph/node_to_chunks.json
GRAPH_FUSE_DENSE=true                  # false -> graph-only results
# Why false is sometimes wanted: while the graph covers less of the corpus than
# the dense index, RRF cannot promote a graph-only chunk into a small top-k —
# graph rank 1 scores 0.4/61 = 0.00656 against dense rank 5 at 0.6/65 = 0.00923.
# Fused mode therefore lets the graph re-rank what dense found but never
# introduce anything, hiding the traversal mechanism.

# ── Embeddings ──────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── ChromaDB ────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost                  # Docker: service name; local: localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=ragscope_corpus

# ── RAGAS ───────────────────────────────────────────────────────────────────
RAGAS_JUDGE_MODEL=qwen2.5:7b          # LLM used to compute RAGAS metrics

# ── Cost Estimation ─────────────────────────────────────────────────────────
COST_PER_1K_PROMPT_TOKENS=0.00        # 0.00 for local inference; set for cloud models
COST_PER_1K_COMPLETION_TOKENS=0.00

# ── Telemetry ───────────────────────────────────────────────────────────────
TELEMETRY_STORE_DIR=./telemetry/store
